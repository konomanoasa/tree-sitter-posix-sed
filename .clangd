CompileFlags:
  Add:
    - -Wall
    - -Wextra
    - -Werror
    - -pedantic

---
If:
  PathMatch: .*\.(c|h)
CompileFlags:
  Add:
    - -std=c17
    - -xc

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header

---
If:
  PathMatch:
    - src/.*
    - posix_sed_ere/src/.*
CompileFlags:
  Add:
    - -I.

---
If:
  PathMatch:
    - common/scanner\.h
    - test/scanner\.test\.c
CompileFlags:
  Add:
    - -DSED_REGEX_EXTENDED=0
    - -I../src

---
If:
  PathMatch: bindings/node/.*\.cc
CompileFlags:
  CompilationDatabase: build/Release
  Add:
    - -std=c++17
