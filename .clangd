CompileFlags:
  Add:
    - -std=c17
    - -xc
    - -Wall
    - -Wextra
    - -Werror
    - -pedantic

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header
    - -Wno-unused-function

---
If:
  PathMatch: test/[^/]*\.c
CompileFlags:
  Add:
    - -Wno-unused-function

---
If:
  PathMatch:
    - src/.*
    - posix_sed_ere/src/.*
CompileFlags:
  Add:
    - -I.

---
If:
  PathMatch:
    - common/scanner\.h
    - test/scanner\.test\.c
CompileFlags:
  Add:
    - -DSED_REGEX_EXTENDED=0
    - -I../src

---
If:
  PathMatch:
    - src/scanner\.c
    - posix_sed_ere/src/scanner\.c
CompileFlags:
  Add:
    - -Wno-unused-function
